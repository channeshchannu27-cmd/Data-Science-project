.ipynb_checkpoints/
*/.ipynb_checkpoints/*
*.ipynb_checkpoints

# IDE, Editor & Workspace Settings
.vscode/
.idea/
*.swp
*.swo
*~
*.code-workspace
.spyderproject
.spyproject

# Operating System Temporary / Metadata Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Thumbs.db:encryptable
desktop.ini
$RECYCLE.BIN/

# Streamlit Local Configuration & Secrets
.streamlit/secrets.toml

